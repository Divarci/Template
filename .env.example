# Secret/config keys the production docker-compose.yml resolves via ${VAR}.
# Committed with KEY NAMES + PLACEHOLDERS ONLY — never real values.
# In production the real .env is delivered via Azure DevOps Secure Files, used for the
# deploy, then removed (see docs/deployment/security.md). Names here must match
# the ${VAR} references in docker-compose.yml exactly.

# ── Persistence (PostgreSQL — managed/external in production) ──
POSTGRES_CONNECTION_STRING=

# ── Caching (Redis — external in production) ──
REDIS_CONNECTION_STRING=

# The Seq log-sink server URL is NOT secret — it is a non-secret base literal in docker-compose.yml.

# Authentication config (OIDC issuer/authority URL + audience id) is NOT secret and is no longer
# sourced from .env — those non-secret external endpoint identifiers are stated as base literals in
# docker-compose.yml. The API only validates bearer tokens, so it needs no Keycloak client secret.
