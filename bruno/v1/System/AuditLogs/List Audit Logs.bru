meta {
  name: List Audit Logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/audit-logs?entityId={{noteId}}&page=1&pageSize=20
  auth: inherit
}

params:query {
  entityId: {{noteId}}
  page: 1
  pageSize: 20
}

vars:post-response {
  auditLogId: res.body.data[0].id
}

assert {
  res.status: eq 200
}

tests {
  test("returns 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("returns a data array", function() {
    expect(res.body.data).to.be.an("array");
  });
  test("returns pagination metadata", function() {
    expect(res.body.metadata).to.have.property("pageNumber");
  });
  test("returns audit entries for the note", function() {
    expect(res.body.data.length).to.be.above(0);
    expect(res.body.data[0].entityId).to.equal(bru.getVar("noteId"));
    expect(res.body.data[0].id).to.be.a("string");
  });
}
