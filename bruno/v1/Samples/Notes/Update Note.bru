meta {
  name: Update Note
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/notes/{{noteId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Bruno happy-path note (updated)",
    "isPinned": true
  }
}

assert {
  res.status: eq 204
}

tests {
  test("returns 204 No Content", function() {
    expect(res.status).to.equal(204);
  });
}
