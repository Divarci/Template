meta {
  name: Get Note By Id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/notes/{{noteId}}
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("returns 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("returns the requested note", function() {
    expect(res.body.data.id).to.equal(bru.getVar("noteId"));
  });
  test("returns the note fields", function() {
    expect(res.body.data.title).to.be.a("string");
    expect(res.body.data).to.have.property("isPinned");
  });
}
